# Copy this file to .env.local to override the defaults below. .env.local is
# gitignored. Every value is optional: with a local Ollama on its default port
# and both llama3.2:3b and embeddinggemma pulled, the app works without any of them.

# Where Ollama is listening, used by src/app/actions.ts and src/lib/rag.ts.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat model. Must already be pulled (`ollama pull llama3.2:3b`).
OLLAMA_MODEL=llama3.2:3b

# Embedding model for the base de conocimiento (.md/.txt files in knowledge/).
# Must already be pulled (`ollama pull embeddinggemma`); a missing model ends the
# turn in the error bubble. With knowledge/ missing or empty, nothing is embedded.
# See docs/adr/0009.
OLLAMA_EMBED_MODEL=embeddinggemma

# Context window in tokens. Ollama truncates silently at this size (its own
# default is 4096), so it is always set explicitly. See docs/adr/0008.
OLLAMA_NUM_CTX=8192
