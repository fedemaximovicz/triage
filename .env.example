# Copy this file to .env.local to override the defaults below. .env.local is
# gitignored. Every value is optional: with a local Ollama on its default port
# and llama3.2:3b pulled, the app works without any of them.

# Where Ollama is listening, used by the server actions in src/app/actions.ts.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Chat model. Must already be pulled (`ollama pull llama3.2:3b`).
OLLAMA_MODEL=llama3.2:3b

# Context window in tokens. Ollama truncates silently at this size (its own
# default is 4096), so it is always set explicitly. See docs/adr/0008.
OLLAMA_NUM_CTX=8192
