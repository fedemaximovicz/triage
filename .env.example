# Copy this file to .env.local and fill in the value. .env.local is gitignored.
# Never commit a real key.

# API key for Gemini, used by the server actions in src/app/actions.ts.
# Get one at https://aistudio.google.com/apikey
# Note: the LlamaIndex Google provider defaults to GOOGLE_API_KEY; this project
# passes GEMINI_API_KEY explicitly instead (see docs/adr/0002).
GEMINI_API_KEY=
